# ---- Telegram Lab Traffic Generator – Streamlit Secrets ----
# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml to version control.

# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN = "123456789:ABCdefGhIJKlmNoPQRsTUVwxYZ"

# Comma-separated Telegram user IDs authorised to run tests
AUTHORIZED_TELEGRAM_USER_IDS = "111111111,222222222"

# Maximum allowed test duration in seconds (default: 120)
MAX_DURATION = "120"

# Maximum allowed packet rate in packets/sec (default: 500)
MAX_RATE = "500"
